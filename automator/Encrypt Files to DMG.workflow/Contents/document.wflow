				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	try
		tell application "System Events"
			activate
			set thePassword to text returned of (display dialog "Enter a password to encrypt the selected items:" default answer "" with hidden answer with title "Encrypt Files to DMG")
			set theConfirm to text returned of (display dialog "Confirm the password:" default answer "" with hidden answer with title "Encrypt Files to DMG")
		end tell
	on error errorMessage number errorNumber
		if errorNumber is -128 then quit me
		error errorMessage number errorNumber
	end try
	if thePassword is "" then
		tell application "System Events" to display dialog "No password was entered. Nothing was encrypted." buttons {"OK"} default button "OK" with icon stop with title "Encrypt Files to DMG"
		quit me
	end if
	if thePassword is not theConfirm then
		tell application "System Events" to display dialog "The passwords did not match. Nothing was encrypted." buttons {"OK"} default button "OK" with icon stop with title "Encrypt Files to DMG"
		quit me
	end if
	return (thePassword as list) &amp; input
end run
</string>
