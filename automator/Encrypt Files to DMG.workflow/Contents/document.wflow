				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash
# Encrypt the selected Finder items into an AES-256 encrypted, compressed,
# read-only disk image (.dmg) alongside the originals.
#
# Input arrives on stdin, one item per line: line 1 is the password, the
# remaining lines are the selected POSIX paths.
#
# @see: https://ss64.com/mac/hdiutil.html

set -euo pipefail

fail() {
    /usr/bin/osascript -e "display dialog \"${1//\"/\\\"}\" buttons {\"OK\"} default button \"OK\" with icon stop" &gt;/dev/null 2&gt;&amp;1 || true
    echo "$1" &gt;&amp;2
    exit 1
}
trap 'fail "Encryption failed. Your original files were not changed."' ERR

# Read the password (line 1), then the selected paths (remaining lines).
IFS= read -r password || password=""

firstpath=""
paths=()
while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -n "$line" ]]; then
        if [[ -z "$firstpath" ]]; then firstpath="$line"; fi
        paths+=("$line")
    fi
done

[[ -n "$password" ]] || fail "No password was entered. Nothing was encrypted."
[[ ${#paths[@]} -gt 0 ]] || fail "No files were selected. Nothing was encrypted."

# Stage a plaintext copy in a temp dir. Note: rm is not a secure wipe, but this
# is acceptable because FileVault encrypts the whole disk.
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

cp -R "${paths[@]}" "$tmpdir/"

now="$(date +"%Y%m%d%H%M%S")"
destdir="$(dirname "$firstpath")"
dmg="$destdir/encrypted-files-$now.dmg"

printf '%s' "$password" | /usr/bin/hdiutil create \
    -encryption AES-256 -stdinpass \
    -fs APFS -format UDZO \
    -volname "Encrypted Files ($now)" \
    -srcfolder "$tmpdir" -ov "$dmg" &gt;/dev/null

# Verify the image reopens with this password and passes its checksum before we
# trust it. If not, delete it so a corrupt backup is never left behind.
mountpoint="$(mktemp -d)"
if printf '%s' "$password" | /usr/bin/hdiutil attach "$dmg" \
        -stdinpass -readonly -nobrowse -mountpoint "$mountpoint" &gt;/dev/null 2&gt;&amp;1; then
    /usr/bin/hdiutil detach "$mountpoint" &gt;/dev/null 2&gt;&amp;1 \
        || /usr/bin/hdiutil detach "$mountpoint" -force &gt;/dev/null 2&gt;&amp;1 || true
    rmdir "$mountpoint" 2&gt;/dev/null || true
else
    rmdir "$mountpoint" 2&gt;/dev/null || true
    rm -f "$dmg"
    fail "Verification failed: the new image could not be reopened, so it was deleted. Your originals were not changed."
fi
</string>
