				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash
# Decrypt .age files created by "Encrypt Files to Age" and extract each into a
# fresh timestamped folder next to the .age file. Existing files are never
# overwritten.
#
# Decryption uses your private identity: ~/.config/age/identity.txt
#
# Input: the selected POSIX paths, passed as arguments.

set -euo pipefail

identity="$HOME/.config/age/identity.txt"

fail() {
    /usr/bin/osascript -e "display dialog \"${1//\"/\\\"}\" buttons {\"OK\"} default button \"OK\" with icon stop" &gt;/dev/null 2&gt;&amp;1 || true
    echo "$1" &gt;&amp;2
    exit 1
}
trap 'fail "Decryption failed."' ERR

# Automator's PATH excludes Homebrew, so use the absolute path directly.
age_bin="/opt/homebrew/bin/age"
[[ -x "$age_bin" ]] || fail "age is not installed. Install it with: brew install age"
[[ -f "$identity" ]] || fail "No identity file at $identity. You need it to decrypt."

[[ $# -gt 0 ]] || fail "No files were selected."

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

now="$(date +"%Y%m%d%H%M%S")"
decrypted_any=0

for f in "$@"; do
    case "$f" in
        *.age) ;;
        *) continue ;;
    esac

    dir="$(dirname "$f")"
    name="$(basename "$f")"
    name="${name%.age}"
    name="${name%.zip}"

    if ! "$age_bin" -d -i "$identity" -o "$tmpdir/dec.zip" "$f" &gt;/dev/null 2&gt;&amp;1; then
        fail "Could not decrypt \"$(basename "$f")\". It may be corrupt or not encrypted for your key."
    fi

    dest="$dir/${name}-decrypted-$now"
    mkdir -p "$dest"
    if ! /usr/bin/unzip -q "$tmpdir/dec.zip" -d "$dest" &gt;/dev/null 2&gt;&amp;1; then
        fail "Decrypted \"$(basename "$f")\" but the archive could not be extracted."
    fi
    decrypted_any=1
done

[[ "$decrypted_any" -eq 1 ]] || fail "No .age files were selected."
</string>
